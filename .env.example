# ==========================================================================
# nonebot-plugin-batarot 配置示例
#
# 使用方法：把下面需要的配置项复制到你 nonebot2 项目根目录下的 .env
#           （或 .env.prod / .env.{ENVIRONMENT}）文件里，保存后重启机器人。
# 变量名大小写不敏感，推荐使用全大写写法。
# ==========================================================================

# --------------------------------------------------------------------------
# 一、原有配置
# --------------------------------------------------------------------------
# 牌阵占卜是否以长消息形式发出，默认 false（使用合并转发），建议不更改
FORWARD_MODE=false


# --------------------------------------------------------------------------
# 二、大模型（AI 解读）辅助占卜
# --------------------------------------------------------------------------
# 【开启说明】总开关：
#   true  = 开启，ba塔罗牌 / ba占卜 / ba运势 / ba塔罗牌解读 在发送本地结果后，
#           会自动追加一条大模型生成的解读；
#   false = 关闭（默认），插件行为与本功能加入前完全一致，不产生任何额外消息。
BATAROT_LLM_ENABLED=false

# 【接口地址】使用 OpenAI 兼容的 /chat/completions 协议，
# 一般写到 /v1 即可，插件会自动补全 /chat/completions。
#   DeepSeek      : https://api.deepseek.com/v1
#   OpenAI        : https://api.openai.com/v1
#   月之暗面 Kimi  : https://api.moonshot.cn/v1
#   智谱 GLM      : https://open.bigmodel.cn/api/paas/v4
#   阿里通义千问   : https://dashscope.aliyuncs.com/compatible-mode/v1
#   SiliconFlow   : https://api.siliconflow.cn/v1
#   本地 Ollama   : http://127.0.0.1:11434/v1
# （如果你的网关路径特殊，也可以直接把完整地址写到 /chat/completions）
BATAROT_LLM_API_BASE=https://api.deepseek.com/v1

# 【接口密钥】必填，形如 sk-xxxxxxxxxxxxxxxx
BATAROT_LLM_API_KEY=

# 模型名称，需与上面的接口地址对应
#   例如 deepseek-chat / deepseek-reasoner / gpt-4o-mini / moonshot-v1-8k 等
BATAROT_LLM_MODEL=deepseek-chat


# --------------------------------------------------------------------------
# 三、可选配置（不写则使用下列默认值）
# --------------------------------------------------------------------------
# 自定义占卜师人设（system 提示词），留空则使用插件内置人设；需写在一行内
# BATAROT_LLM_SYSTEM_PROMPT=你是一位温柔而专业的塔罗牌占卜师……

# 采样温度，越大越发散，建议 0.7 ~ 1.2
# BATAROT_LLM_TEMPERATURE=0.9

# 单次解读最大生成长度，设为 0 表示不发送该参数
# BATAROT_LLM_MAX_TOKENS=800

# 单次请求超时时间（秒）
# BATAROT_LLM_TIMEOUT=60

# 同一用户两次 AI 解读的最小间隔（秒），设为 0 表示不限制
# BATAROT_LLM_COOLDOWN=10

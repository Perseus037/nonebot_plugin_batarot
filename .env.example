# 复制需要的配置到机器人项目 .env，保存后重启。

# false：OneBot v11 群聊合并转发；true：一条普通图文消息
FORWARD_MODE=false

# 每群每人独立保存；同一文件只能由一个机器人进程使用
BATAROT_DATA_FILE=data/batarot/state.json
BATAROT_INITIAL_LUCK=10
# 下限 -5～0，上限 0～5；某侧为 0 时对应正/逆位不加减分
BATAROT_LUCK_MIN=-5
BATAROT_LUCK_MAX=5
# 普通三条命令共用的每日 AI 额度；0 关闭这些额外 AI，幸运牌机会独立
BATAROT_LLM_DAILY_LIMIT=3
# 默认北京时间零点日切
BATAROT_DAY_UTC_OFFSET=8

# AI 可选；开启前填写自己的密钥和服务商支持的模型
BATAROT_LLM_ENABLED=false
BATAROT_LLM_API_BASE=https://api.deepseek.com/v1
BATAROT_LLM_API_KEY=
BATAROT_LLM_MODEL=deepseek-flash

# auto 仅向已识别接口/模型发送思考参数；可选 deepseek / siliconflow / none
BATAROT_LLM_THINKING_PROVIDER=auto
BATAROT_LLM_THINKING=false
BATAROT_LLM_MAX_CONCURRENCY=2
BATAROT_LLM_MAX_QUESTION_CHARS=1000
BATAROT_LLM_COOLDOWN=10
BATAROT_LLM_TIMEOUT=60
BATAROT_LLM_MAX_TOKENS=800
BATAROT_LLM_TEMPERATURE=0.9
BATAROT_LLM_SYSTEM_PROMPT=

# 可选：同一币种的每百万 token 价格，仅用于日志估算，不代表实际扣费
# BATAROT_LLM_INPUT_PRICE_PER_MILLION=0
# BATAROT_LLM_OUTPUT_PRICE_PER_MILLION=0
